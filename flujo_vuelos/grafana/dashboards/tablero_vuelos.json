      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aws-vuelos"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT periodo AS time, SUM(retrasados) * 100.0 / NULLIF(SUM(operados), 0) AS \"% retraso\"\nFROM analitica_vuelos WHERE anio IN ($anio) AND nombre_aerolinea IN ($aerolinea)\nGROUP BY periodo ORDER BY periodo"
        }

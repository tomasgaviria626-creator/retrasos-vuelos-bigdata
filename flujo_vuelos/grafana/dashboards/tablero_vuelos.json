    {
      "id": 11,
      "type": "table",
      "title": "Ejecuciones del flujo de Prefect (tabla registro_cargas)",
      "description": "Una fila por cada vez que corre el flujo: muestra cuándo se actualizaron los datos del tablero.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aws-vuelos"
      },
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aws-vuelos"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",

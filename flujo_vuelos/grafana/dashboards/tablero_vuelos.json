    {
      "id": 10,
      "type": "table",
      "title": "Los 10 aeropuertos de origen con más vuelos",
      "description": "Nivel de puntualidad con los límites de niveles_puntualidad.csv: Alta < 15 %, Media 15–20 %, Baja ≥ 20 %.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aws-vuelos"
      },
      "gridPos": {
        "x": 9,
        "y": 22,
        "w": 15,
        "h": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aws-vuelos"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT origin AS \"Aeropuerto\",\n       SUM(vuelos) AS \"Vuelos\",\n       SUM(retrasados) * 100.0 / NULLIF(SUM(operados), 0) AS \"% retraso\",\n       SUM(cancelados) * 100.0 / NULLIF(SUM(vuelos), 0) AS \"% cancelados\",\n       SUM(suma_retraso_min) / NULLIF(SUM(operados), 0) AS \"Retraso medio (min)\",\n       CASE WHEN SUM(retrasados) * 100.0 / NULLIF(SUM(operados), 0) < 15 THEN 'Alta' WHEN SUM(retrasados) * 100.0 / NULLIF(SUM(operados), 0) < 20 THEN 'Media' ELSE 'Baja' END AS \"Puntualidad\"\nFROM analitica_vuelos WHERE anio IN ($anio) AND nombre_aerolinea IN ($aerolinea)\nGROUP BY origin ORDER BY 2 DESC LIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "custom": {

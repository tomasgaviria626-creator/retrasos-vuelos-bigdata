    {
      "id": 5,
      "type": "timeseries",
      "title": "% de vuelos con retraso por mes",
      "description": "Evolución mensual. Las líneas punteadas marcan los límites de 15 % y 20 %.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aws-vuelos"
      },
      "gridPos": {
        "x": 0,

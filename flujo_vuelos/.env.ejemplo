# Copie este archivo como .env y cambie las claves. El archivo .env NO se sube a GitHub.

# Base local en Docker (simula el servidor de la compañía)
LOCAL_HOST=localhost
LOCAL_PORT=55432
LOCAL_USER=postgres
LOCAL_PASSWORD=cambie_esta_clave
LOCAL_DB=vuelos_local

# Base en AWS (RDS PostgreSQL): solo recibe los resultados de la analítica
AWS_HOST=su-instancia.xxxxxxxxxx.us-east-1.rds.amazonaws.com
AWS_PORT=5432
AWS_USER=postgres
AWS_PASSWORD=cambie_esta_clave
AWS_DB=vuelos_analitica

# Interfaz de Prefect (la levanta docker-compose). Si no la usa, ponga un # al inicio de la línea.
PREFECT_API_URL=http://127.0.0.1:4200/api

# Grafana (lo levanta docker-compose en http://localhost:3000). Usuario: admin
GRAFANA_PASSWORD=cambie_esta_clave
